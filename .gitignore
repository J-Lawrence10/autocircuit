# ============================================================
# Neuronpedia Pipeline Generated Data
# ============================================================
# Keep directory structure but ignore all generated data
neuronpedia_pipeline/data/prompts/*/1_generation/
neuronpedia_pipeline/data/prompts/*/2_conversion/
neuronpedia_pipeline/data/prompts/*/3_analysis/
neuronpedia_pipeline/data/prompts/*/4_visualizations/
neuronpedia_pipeline/data/prompts/*/7_minimal_pathways/
neuronpedia_pipeline/data/prompts/*/8_evolution/
neuronpedia_pipeline/data/prompts/*/9_steering/
neuronpedia_pipeline/data/prompts/*/10_polysemanticity/

# Keep .gitkeep files for structure
!neuronpedia_pipeline/data/prompts/.gitkeep
!neuronpedia_pipeline/data/.gitkeep
!**/.gitkeep

